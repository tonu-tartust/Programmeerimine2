@page "/create"
@page "/edit/{Id:int}"

@inject KooliProjekt.BlazorWasm.IApiClient apiClient
@inject NavigationManager NavManager

<h3>@title</h3>

<EditForm EditContext="editContext" OnSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p class="alert-danger">@error</p>

    <div class="form-group row">
        <label class="col-ms-2 col-form-label">ID</label>
        <div class="col-sm-10">
            @employee.Id
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">First Name</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.FirstName" />
            <ValidationMessage For="@(() => employee.FirstName)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Last Name</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.LastName" />
            <ValidationMessage For="@(() => employee.LastName)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Email</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.Email" />
            <ValidationMessage For="@(() => employee.Email)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Phone</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.Phone" />
            <ValidationMessage For="@(() => employee.Phone)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Role</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.Role" />
            <ValidationMessage For="@(() => employee.Role)" />
        </div>
    </div>

    <div class="form-group row mt-2">
        <label class="col-ms-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" href="/employees">Back</a>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private string error = "";
    private string title = "Edit";
    private EditContext? editContext;
    private Employee employee = new Employee();

    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(employee);
        messageStore = new ValidationMessageStore(editContext);

        if(Id == 0)
        {
            title = "Add";            
            return;
        }        

        var response = await apiClient.Get(Id);
        if(!response.HasErrors)
        {
            employee = response.Value;
            editContext = new EditContext(employee);
            messageStore = new ValidationMessageStore(editContext);
        }
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        messageStore?.Clear();

        var result = await apiClient.Save(employee);
        if (!result.HasErrors)
        {
            NavManager.NavigateTo("/employees");
            return;
        }

        foreach (var error in result.Errors)
        {
            messageStore?.Add(new FieldIdentifier(employee, string.Empty), error);
        }

        foreach (var error in result.PropertyErrors)
        {
            var propertyName = error.Key[0].ToString().ToUpper() + error.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(employee, propertyName), error.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
